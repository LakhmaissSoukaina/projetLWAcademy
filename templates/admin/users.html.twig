{% extends 'base.html.twig' %}

{% block body %}
    <h1>Liste des utilisateurs</h1>
    <table class="table">
        <thead>
            <tr>
                <th>Email</th>
                <th>Nom complet</th>
                <th>Rôles</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.email }}</td>
                <td>{{ user.nomComplet }}</td>
                <td>{{ user.roles|join(', ') }}</td>
                <td>
                    <a href="{{ path('admin_edit_roles', {id: user.id}) }}" class="btn btn-sm btn-primary">Éditer les rôles</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}